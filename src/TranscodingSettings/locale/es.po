#: ../plugin.py:102
msgid "Encoder Presets"
msgstr "Ajustes predefinidos del codificador"

#. XML context: item attribute 'text'
#: ../setup.xml:6
msgid "Encoder selection"
msgstr "Selección del codificador"

#: ../configuration.py:165
msgid "Follow Live"
msgstr "Sigue el stream en vivo"

#. XML context: item attribute 'description'
#: ../setup.xml:16
msgid "Follow Live republishes the channel currently playing on the receiver. HDMI Input uses the receiver's HDMI input service. A service reference supplied by OpenWebif temporarily overrides this setting for that stream."
msgstr "La función Seguir en directo reproduce el canal que se está emitiendo en el receptor. La entrada HDMI utiliza el servicio de entrada HDMI del receptor. Una referencia de servicio proporcionada por OpenWebif anula temporalmente esta configuración para ese stream."

#. XML context: item attribute 'description'
#: ../setup.xml:87
msgid "For HiSilicon, WTE, Vu+ and GigaBlue port-8001 streaming, enigma2-live555 republishes the transport stream produced by Enigma2. Only bitrate, resolution, frame rate, video codec, aspect ratio and scan mode are passed to that pipeline."
msgstr "Para el stream a través del puerto 8001 de HiSilicon, WTE, Vu+ y GigaBlue, enigma2-live555 vuelve a publicar el flujo de transporte producido por Enigma2. Solo se pasan a esa canalización la tasa de bits, la resolución, la velocidad de fotogramas, el códec de vídeo, la relación de aspecto y el modo de escaneo."

#. XML context: item attribute 'description'
#: ../setup.xml:78
msgid "GOP duration in milliseconds. Zero lets the live server calculate it from the P-frame setting. Incorrect GOP settings can delay HLS segment creation or cause client startup failures."
msgstr "Duración del GOP en milisegundos. Si se establece en cero, el servidor lo calcula a partir de la configuración del fotograma P. Una configuración incorrecta del GOP puede retrasar la creación del segmento HLS o provocar fallos al iniciar el cliente."

#. XML context: item attribute 'description'
#: ../setup.xml:84
msgid "H.264 level used by the Dreamsource pipeline. Choose a level compatible with the selected resolution and frame rate."
msgstr "Nivel H.264 utilizado por el flujo de trabajo de Dreamsource. Elija un nivel compatible con la resolución y la velocidad de fotogramas seleccionadas."

#. XML context: item attribute 'description'
#: ../setup.xml:85
msgid "H.264 profile used by the Dreamsource pipeline. Main is the safest choice; High may not play on older clients."
msgstr "El sistema Dreamsource utiliza el perfil H.264. La opción Main es la más segura; la opción Alto podría no funcionar en clientes antiguos."

#: ../configuration.py:167
msgid "HDMI Input"
msgstr "Entrada HDMI"

#. XML context: item attribute 'text'
#: ../setup.xml:24
msgid "HLS and RTSP are not available on port 8002"
msgstr "HLS y RTSP no están disponibles en el puerto 8002"

#: ../backend.py:65
msgid "HLS and RTSP must use different listening ports."
msgstr "HLS y RTSP deben usar puertos de escucha diferentes."

#. XML context: item attribute 'text'
#: ../setup.xml:64
msgid "HLS listening port"
msgstr "Puerto de escucha HLS"

#. XML context: item attribute 'text'
#: ../setup.xml:67
msgid "HLS password"
msgstr "Contraseña HLS"

#. XML context: item attribute 'text'
#: ../setup.xml:65
msgid "HLS path"
msgstr "Ruta HLS"

#. XML context: item attribute 'text'
#: ../setup.xml:17
