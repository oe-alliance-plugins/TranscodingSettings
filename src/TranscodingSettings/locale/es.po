#. XML context: item attribute 'text'
#: ../setup.xml:44
msgid "Encoder 1 video bitrate"
msgstr "Tasa de bits de vídeo del codificador 1"

#. XML context: item attribute 'text'
#: ../setup.xml:47
msgid "Encoder 1 video codec"
