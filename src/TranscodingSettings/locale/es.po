msgstr "Servidor HLS"

#. XML context: item attribute 'text'
#: ../setup.xml:66
msgid "HLS user"
msgstr "Usuario HLS"

#. XML context: item attribute 'text'
#: ../setup.xml:61
msgid "HLS/RTSP audio bitrate"
msgstr "Tasa de bits de audio HLS/RTSP"

#: ../backend.py:57
msgid "HLS/RTSP requires /usr/bin/enigma2-live555."
msgstr "HLS/RTSP requiere /usr/bin/enigma2-live555."

#: ../backend.py:59
msgid "HLS/RTSP requires the Enigma2 eStreamServer API."
msgstr "HLS/RTSP requiere la API Enigma2 eStreamServer."

#. XML context: item attribute 'text'
#: ../setup.xml:16
msgid "HLS/RTSP source"
msgstr "Fuente HLS/RTSP"

#. XML context: item attribute 'text'
#: ../setup.xml:59
msgid "HLS/RTSP streaming settings"
msgstr "Configuración de stream HLS/RTSP"

#. XML context: item attribute 'text'
#: ../setup.xml:20
msgid "HLS/RTSP unavailable: enigma2-live555 or the eStreamServer API is missing"
msgstr "HLS/RTSP no disponible: falta enigma2-live555 o la API eStreamServer"

#. XML context: item attribute 'text'
#: ../setup.xml:60
msgid "HLS/RTSP video codec"
msgstr "códec de vídeo HLS/RTSP"

#: ../configuration.py:104 ../configuration.py:137 ../configuration.py:147
#: ../configuration.py:450
msgid "High"
msgstr "Alto"

#: ../configuration.py:105
msgid "Higher"
msgstr "Más alto"

#: ../configuration.py:393
msgid "Interlaced"
msgstr "Entrelazado"

#. XML context: item attribute 'text'
#: ../setup.xml:80
msgid "Live B-frames"
msgstr "Fotogramas B en directo"

#. XML context: item attribute 'text'
#: ../setup.xml:78
msgid "Live GOP length"
msgstr "Duración GOP en directo"

#. XML context: item attribute 'text'
#: ../setup.xml:79
msgid "Live P-frames"
msgstr "Fotogramas P en directo"

#. XML context: item attribute 'text'
#: ../setup.xml:84
msgid "Live codec level"
msgstr "Nivel de códec en vivo"

#. XML context: item attribute 'text'
#: ../setup.xml:85
msgid "Live codec profile"
msgstr "Perfil de códec en vivo"

#. XML context: item attribute 'text'
#: ../setup.xml:83
msgid "Live encoder slices"
msgstr "Segmentos del codificador en vivo"

#: ../configuration.py:102
msgid "Low"
msgstr "Bajo"

#: ../configuration.py:137 ../configuration.py:147 ../configuration.py:450
msgid "Main"
msgstr "Principal"

#: ../configuration.py:107
msgid "Maximum"
msgstr "Máximo"

#: ../configuration.py:103
msgid "Medium"
msgstr "Medio"

#. XML context: item attribute 'text'
#: ../setup.xml:82
msgid "New GOP on scene change"
msgstr "Nuevo GOP en escena"

#. XML context: item attribute 'description'
#: ../setup.xml:52
msgid "Number of B-frames in encoder 1's GOP."
msgstr "Número de fotogramas B en el GOP del codificador 1."

#. XML context: item attribute 'description'
#: ../setup.xml:37
msgid "Number of B-frames in the encoder GOP. B-frames can improve compression but increase latency and are not supported by every profile."
msgstr "Número de fotogramas B en el GOP del codificador. Los fotogramas B pueden mejorar la compresión, pero aumentan la latencia y no son compatibles con todos los perfiles."

#. XML context: item attribute 'description'
#: ../setup.xml:80
msgid "Number of B-frames used by the Dreamsource encoder pipeline. B-frames can increase latency and require a compatible profile."
msgstr "Número de fotogramas B utilizados por el proceso de codificación de Dreamsource. Los fotogramas B pueden aumentar la latencia y requieren un perfil compatible."

#. XML context: item attribute 'description'
#: ../setup.xml:83
msgid "Number of H.264 slices. Multiple slices may improve error resilience but add overhead and are not useful for most home networks."
msgstr "Número de segmentos H.264. El uso de múltiples segmentos puede mejorar la resistencia a errores, pero aumenta la sobrecarga y no resulta útil para la mayoría de las redes domésticas."

#. XML context: item attribute 'description'
#: ../setup.xml:53
msgid "Number of P-frames in encoder 1's GOP."
msgstr "Número de fotogramas P en el GOP del codificador 1."

#. XML context: item attribute 'description'
#: ../setup.xml:38
msgid "Number of P-frames in the encoder GOP. Larger values improve compression but make recovery after packet loss slower."
msgstr "Número de fotogramas P en el GOP del codificador. Valores mayores mejoran la compresión, pero ralentizan la recuperación tras la pérdida de paquetes."

#. XML context: item attribute 'description'
#: ../setup.xml:79
msgid "Number of P-frames used when GOP length is automatic. Larger values improve compression but increase recovery latency."
msgstr "Número de fotogramas P utilizados cuando la longitud del GOP es automática. Valores mayores mejoran la compresión, pero aumentan la latencia de recuperación."

#: ../configuration.py:461
msgid "Off"
msgstr "Apagado"

#: ../configuration.py:461
msgid "On"
msgstr "Encendido"

#. XML context: item attribute 'text'
#: ../setup.xml:81
msgid "Open GOP"
msgstr "Abrir GOP"

#. XML context: item attribute 'description'
#: ../setup.xml:66
msgid "Optional HTTP user name. Leave empty to disable HLS authentication."
msgstr "Nombre de usuario HTTP opcional. Déjelo en blanco para deshabilitar la autenticación HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:72
msgid "Optional RTSP user name. Leave empty to disable RTSP authentication."
msgstr "Nombre de usuario RTSP opcional. Déjelo en blanco para desactivar la autenticación RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:45
msgid "Output dimensions for encoder 1."
msgstr "Dimensiones de salida para el codificador 1."

#. XML context: item attribute 'description'
#: ../setup.xml:30
msgid "Output dimensions. High resolutions need a sufficiently high bitrate and may not be accepted with every codec or frame rate."
msgstr "Dimensiones de salida. Las resoluciones altas requieren una tasa de bits suficientemente alta y es posible que no sean compatibles con todos los códecs o velocidades de fotogramas."

#. XML context: item attribute 'description'
#: ../setup.xml:46
msgid "Output frame rate for encoder 1."
msgstr "Velocidad de fotogramas de salida para el codificador 1."

#. XML context: item attribute 'description'
#: ../setup.xml:31
msgid "Output frame rate. Do not combine a high frame rate, high resolution and low bitrate unless the encoder is known to support it."
msgstr "Velocidad de fotogramas de salida. No combine una alta velocidad de fotogramas, una alta resolución y una baja tasa de bits a menos que se sepa que el codificador lo admite."

#. XML context: item attribute 'description'
#: ../setup.xml:67
msgid "Password used with the HLS user name."
msgstr "Contraseña utilizada con el nombre de usuario HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:73
msgid "Password used with the RTSP user name."
msgstr "Contraseña utilizada con el nombre de usuario RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:65
msgid "Playlist path without leading or trailing slash. For example, path 'stream' creates /stream.m3u8."
msgstr "Ruta de la lista de reproducción sin barra diagonal inicial ni final. Por ejemplo, la ruta 'stream' crea /stream.m3u8."

#. XML context: item attribute 'description'
#: ../setup.xml:5
msgid "Port 8001 uses the Enigma2 stream server and supports the optional HLS and RTSP service. Port 8002 uses the BCM transcoding proxy and never provides HLS or RTSP."
msgstr "El puerto 8001 utiliza el servidor de stream Enigma2 y admite los servicios opcionales HLS y RTSP. El puerto 8002 utiliza el proxy de transcodificación BCM y nunca proporciona HLS ni RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:24
msgid "Port 8002 is retained for BCM receivers and the classic transcoding proxy. Select port 8001 to use HLS or RTSP."
msgstr "El puerto 8002 se reserva para los receptores BCM y el proxy de transcodificación clásico. Seleccione el puerto 8001 para usar HLS o RTSP."

#: ../plugin.py:38
msgid "Presets"
msgstr "Ajustes predefinidos"

#: ../configuration.py:393
msgid "Progressive"
msgstr "Progresivo"

#. XML context: item attribute 'description'
#: ../setup.xml:50
msgid "Progressive or interlaced output for encoder 1."
msgstr "Salida progresiva o entrelazada para el codificador 1."

#. XML context: item attribute 'description'
#: ../setup.xml:35
msgid "Progressive output is normally appropriate for HLS/RTSP. Interlaced output can be incompatible with some clients and encoder combinations."
msgstr "La salida progresiva suele ser adecuada para HLS/RTSP. La salida entrelazada puede ser incompatible con algunas combinaciones de clientes y codificadores."

#. XML context: item attribute 'description'
#: ../setup.xml:17
msgid "Publish the selected transcoded service as an HLS playlist. Saving this option starts enigma2-live555 on demand. The daemon stops again when both HLS and RTSP are disabled, transcoding is disabled, or port 8002 is selected. HLS uses H.264 or H.265 video with AAC audio."
msgstr "Publica el servicio transcodificado seleccionado como una lista de reproducción HLS. Al guardar esta opción, enigma2-live555 se inicia bajo demanda. El demonio se detiene cuando HLS y RTSP están desactivados, la transcodificación está desactivada o se selecciona el puerto 8002. HLS utiliza vídeo H.264 o H.265 con audio AAC."

#. XML context: item attribute 'description'
#: ../setup.xml:18
msgid "Publish the selected transcoded service through RTSP. Saving this option starts enigma2-live555 on demand. The daemon stops again when both HLS and RTSP are disabled, transcoding is disabled, or port 8002 is selected. TCP transport is normally more reliable than UDP on wireless networks."
msgstr "Publica el servicio transcodificado seleccionado mediante RTSP. Al guardar esta opción, enigma2-live555 se inicia bajo demanda. El demonio se detiene cuando se desactivan HLS y RTSP, se desactiva la transcodificación o se selecciona el puerto 8002. El transporte TCP suele ser más fiable que UDP en redes inalámbricas."

#. XML context: item attribute 'text'
#: ../setup.xml:70
msgid "RTSP listening port"
msgstr "Puerto de escucha RTSP"

#. XML context: item attribute 'description'
#: ../setup.xml:71
msgid "RTSP mount path without leading or trailing slash."
msgstr "Ruta de montaje RTSP sin barra diagonal inicial ni final."

#. XML context: item attribute 'text'
#: ../setup.xml:73
msgid "RTSP password"
msgstr "Contraseña RTSP"

#. XML context: item attribute 'text'
#: ../setup.xml:71
msgid "RTSP path"
msgstr "Ruta RTSP"

#. XML context: item attribute 'text'
#: ../setup.xml:18
msgid "RTSP server"
msgstr "Servidor RTSP"

#. XML context: item attribute 'text'
#: ../setup.xml:72
msgid "RTSP user"
msgstr "Usuario RTSP"

#: ../plugin.py:98
#, python-format
msgid "Select a preset for Encoder %d. The values are adapted to this device."
msgstr "Seleccione un valor preestablecido para el codificador %d. Los valores están adaptados a este dispositivo."

#: ../plugin.py:41
msgid "Select a ready-to-use preset for the highlighted encoder"
msgstr "Seleccione un preajuste listo para usar para el codificador resaltado"

#: ../plugin.py:42
msgid "Show or hide advanced transcoding settings"
msgstr "Mostrar u ocultar la configuración avanzada de transcodificación"

#. XML context: item attribute 'description'
#: ../setup.xml:82
msgid "Start a new GOP on large scene changes. This may improve quality but produces less predictable segment boundaries."
msgstr "Inicie un nuevo GOP en los cambios de escena importantes. Esto puede mejorar la calidad, pero produce límites de segmento menos predecibles."

#. XML context: item attribute 'description'
#: ../setup.xml:64
msgid "TCP port used by the HLS HTTP server. It must differ from ports 8001, 8002 and the RTSP port."
msgstr "Puerto TCP utilizado por el servidor HTTP HLS. Debe ser diferente de los puertos 8001, 8002 y del puerto RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:70
msgid "TCP/UDP port used by the RTSP server. It must differ from ports 8001, 8002 and the HLS port."
msgstr "Puerto TCP/UDP utilizado por el servidor RTSP. Debe ser diferente de los puertos 8001, 8002 y del puerto HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:44
msgid "Target video bitrate for encoder 1."
msgstr "Tasa de bits de vídeo objetivo para el codificador 1."

#. XML context: item attribute 'description'
#: ../setup.xml:29
msgid "Target video bitrate. A lower value reduces network traffic but also reduces picture quality. Very low bitrates may cause block artifacts or encoder failure at high resolutions."
msgstr "Tasa de bits de vídeo objetivo. Un valor menor reduce el tráfico de red, pero también disminuye la calidad de la imagen. Tasas de bits muy bajas pueden provocar artefactos de bloqueo o fallos en el codificador a altas resoluciones."

#. XML context: item attribute 'description'
#: ../setup.xml:20
msgid "The basic port-8001 transcoding stream remains usable. Install the enigma2-live555 binary and an Enigma2 build with the eStreamServer interface to enable HLS and RTSP."
msgstr "El stream de transcodificación básica del puerto 8001 sigue funcionando. Instale el binario enigma2-live555 y una compilación de Enigma2 con la interfaz eStreamServer para habilitar HLS y RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:28
msgid "The following values configure encoder 0. Unsupported proc controls are not written, but the common values are also used to construct port-8001 streaming requests."
msgstr "Los siguientes valores configuran el codificador 0. Los controles de procedimiento no compatibles no se escriben, pero los valores comunes también se utilizan para construir solicitudes de stream del puerto 8001."

#. XML context: item attribute 'text'
#: ../setup.xml:87
msgid "The generic port-8001 pipeline does not provide separate GOP, profile, level or audio-bitrate controls"
msgstr "La canalización genérica del puerto 8001 no proporciona controles separados de GOP, perfil, nivel o tasa de bits de audio"

#: ../backend.py:78
msgid "The selected codec is not supported by every encoder that Auto may allocate for HLS/RTSP."
msgstr "El códec seleccionado no es compatible con todos los codificadores que Auto puede asignar para HLS/RTSP."

#: ../backend.py:80
msgid "The selected encoder does not support this codec for HLS/RTSP."
msgstr "El codificador seleccionado no admite este códec para HLS/RTSP."

#: ../backend.py:49
msgid "The selected transcoding port is not available on this receiver."
msgstr "El puerto de transcodificación seleccionado no está disponible en este receptor."

#. XML context: item attribute 'description'
#: ../setup.xml:59
msgid "These settings control enigma2-live555 only. They do not change the codec choices available to a normal port-8001 or port-8002 client."
msgstr "Estos ajustes controlan únicamente enigma2-live555. No modifican las opciones de códec disponibles para un cliente normal de puerto 8001 o puerto 8002."

#. XML context: setup attribute 'title'
#: ../plugin.py:25 ../setup.xml:2
msgid "Transcoding Settings"
msgstr "Configuración de transcodificación"

#: ../plugin.py:43
msgid "Transcoding Settings Actions"
msgstr "Acciones de configuración de transcodificación"

#. XML context: item attribute 'text'
#: ../setup.xml:5
msgid "Transcoding port"
msgstr "Puerto de transcodificación"

#: ../configuration.py:101
msgid "Very Low"
msgstr "Muy bajo"

#. XML context: item attribute 'description'
#: ../setup.xml:47
msgid "Video codec used by encoder 1 for normal transcoding."
msgstr "Códec de vídeo utilizado por el codificador 1 para la transcodificación normal."

#. XML context: item attribute 'description'
#: ../setup.xml:32
msgid "Video codec used for normal transcoding. HLS/RTSP has a separate codec selection restricted to H.264 and H.265. Some older BCM encoders support only H.264."
msgstr "Códec de vídeo utilizado para la transcodificación normal. HLS/RTSP tiene una selección de códec independiente, restringida a H.264 y H.265. Algunos codificadores BCM antiguos solo admiten H.264."
