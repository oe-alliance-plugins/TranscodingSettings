#: ../backend.py:71
#, python-format
msgid "%s cannot listen on transcoding port %d."
msgstr "%s no puede escuchar en el puerto de transcodificación %d."

#. XML context: item attribute 'description'
#: ../setup.xml:61
msgid "AAC audio bitrate in kbit/s for the Dreamsource encoder. The generic port-8001 pipeline does not expose an audio-bitrate control and therefore keeps the hardware encoder's AAC bitrate."
msgstr "Tasa de bits de audio AAC en kbit/s para el codificador Dreamsource. La canalización genérica del puerto 8001 no expone un control de tasa de bits de audio y, por lo tanto, mantiene la tasa de bits AAC del codificador de hardware."

#: ../plugin.py:39 ../plugin.py:115
msgid "Advanced"
msgstr "Avanzado"

#. XML context: item attribute 'description'
#: ../setup.xml:36
msgid "Allow encoder 0 to choose bitrate or frame-rate behaviour automatically. This option is shown only when the driver exports an automode node."
msgstr "Permite que el codificador 0 elija automáticamente el comportamiento de la tasa de bits o la velocidad de fotogramas. Esta opción solo se muestra cuando el controlador exporta un nodo de modo automático."

#. XML context: item attribute 'description'
#: ../setup.xml:51
msgid "Allow encoder 1 to choose automatic bitrate or frame-rate behaviour."
msgstr "Permitir que el codificador 1 elija el comportamiento automático de tasa de bits o de velocidad de fotogramas."

#. XML context: item attribute 'description'
#: ../setup.xml:81
msgid "Allow frames to reference pictures from the previous GOP. This can improve compression but may reduce seeking and HLS segment independence."
msgstr "Permitir que los fotogramas hagan referencia a las imágenes del GOP anterior. Esto puede mejorar la compresión, pero podría reducir la independencia de la búsqueda y del segmento HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:49
msgid "Aspect-ratio signalling for encoder 1."
msgstr "Señalización de relación de aspecto para el codificador 1."

#. XML context: item attribute 'description'
#: ../setup.xml:34
msgid "Aspect-ratio signalling passed to the encoder. Use the driver default when forced 4:3 or 16:9 signalling produces a distorted picture."
msgstr "La señal de relación de aspecto se envía al codificador. Utilice la configuración predeterminada del controlador cuando la señalización forzada de 4:3 o 16:9 produzca una imagen distorsionada."

#. XML context: item attribute 'description'
#: ../setup.xml:48
msgid "Audio codec used by encoder 1 when supported by its driver."
msgstr "Códec de audio utilizado por el codificador 1 cuando su controlador lo admite."

#. XML context: item attribute 'description'
#: ../setup.xml:33
msgid "Audio codec used by the hardware encoder when the driver exposes this control. HLS/RTSP always uses AAC because enigma2-live555 currently supports AAC audio only."
msgstr "Códec de audio utilizado por el codificador de hardware cuando el controlador expone este control. HLS/RTSP siempre usa AAC porque enigma2-live555 actualmente solo admite audio AAC."

#: ../configuration.py:173
msgid "Auto (first free)"
msgstr "Automático (primera edición gratuita)"

#. XML context: item attribute 'description'
#: ../setup.xml:6
msgid "Auto is the default and lets every port-8001 request use the first free hardware encoder. Parallel streams can therefore use encoder 0 and encoder 1. Select a fixed encoder only for testing or when a client must always use one physical encoder."
msgstr "La opción Automático es la predeterminada y permite que cada solicitud al puerto 8001 utilice el primer codificador de hardware disponible. Por lo tanto, los streams paralelos pueden usar el codificador 0 y el codificador 1. Seleccione un codificador fijo solo para realizar pruebas o cuando un cliente deba usar siempre un único codificador físico."

#: ../configuration.py:247 ../configuration.py:257 ../configuration.py:385
msgid "Automatic"
msgstr "Automático"

#: ../configuration.py:450
msgid "Baseline"
msgstr "Base"

#: ../plugin.py:115
msgid "Basic"
msgstr "Básico"

#: ../configuration.py:106
msgid "Best"
msgstr "Mejor"

#. XML context: item attribute 'description'
#: ../setup.xml:8
msgid "Choose a ready-to-use quality profile. Values are adapted to the choices exported by encoder 0. Select Custom to edit the individual settings in Advanced view."
msgstr "Seleccione un perfil de calidad predefinido. Los valores se adaptan a las opciones exportadas por el codificador 0. Seleccione Personalizado para editar la configuración individual en la vista Avanzada."

#. XML context: item attribute 'description'
#: ../setup.xml:11
msgid "Choose an independent quality profile for encoder 1. This does not copy settings from encoder 0."
msgstr "Seleccione un perfil de calidad independiente para el codificador 1. Esto no copia la configuración del codificador 0."

#. XML context: item attribute 'description'
#: ../setup.xml:55
msgid "Codec level for encoder 1."
msgstr "Nivel de códec para el codificador 1."

#. XML context: item attribute 'description'
#: ../setup.xml:40
msgid "Codec level limits resolution, frame rate and bitrate. A level that is too low for the selected values can prevent the stream from starting."
msgstr "El nivel del códec limita la resolución, la velocidad de fotogramas y la tasa de bits. Un nivel demasiado bajo para los valores seleccionados puede impedir que se inicie el stream."

#. XML context: item attribute 'description'
#: ../setup.xml:39
msgid "Codec profile exported by the driver. Invalid profile, codec and level combinations can produce a black screen; keep the default when unsure."
msgstr "El controlador exporta el perfil del códec. Las combinaciones no válidas de perfil, códec y nivel pueden provocar una pantalla en negro; si tiene dudas, mantenga la configuración predeterminada."

#. XML context: item attribute 'description'
#: ../setup.xml:54
msgid "Codec profile for encoder 1. Keep the default when the supported combinations are unknown."
msgstr "Perfil de códec para el codificador 1. Mantenga el valor predeterminado cuando se desconozcan las combinaciones compatibles."

#. XML context: item attribute 'description'
#: ../setup.xml:60
msgid "Codec used by HLS and RTSP. Only H.264 and H.265 are accepted by the current live server; Dreamsource devices are limited to H.264."
msgstr "Códec utilizado por HLS y RTSP. El servidor actual solo acepta H.264 y H.265; los dispositivos Dreamsource están limitados a H.264."

#: ../plugin.py:26
msgid "Configure hardware transcoding, HLS and RTSP"
msgstr "Configurar la transcodificación de hardware, HLS y RTSP"

#: ../configuration.py:108
msgid "Custom"
msgstr "Personalizado"

#. XML context: item attribute 'description'
#: ../setup.xml:3
msgid "Enable the receiver's hardware encoder and allow OpenWebif to create reduced-bandwidth streams. Disable this option when the encoder must not be used."
msgstr "Habilite el codificador de hardware del receptor y permita que OpenWebif cree streams de ancho de banda reducido. Desactive esta opción cuando no sea necesario utilizar el codificador."

#. XML context: item attribute 'text'
#: ../setup.xml:3
msgid "Enable transcoding"
msgstr "Habilitar la transcodificación"

