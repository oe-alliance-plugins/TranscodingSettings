msgstr "Przepływność dźwięku HLS/RTSP"

#. XML context: item attribute 'text'
#: ../setup.xml:59
msgid "HLS/RTSP streaming settings"
msgstr "Ustawienia strumieniowania HLS/RTSP"

#. XML context: item attribute 'text'
#: ../setup.xml:60
