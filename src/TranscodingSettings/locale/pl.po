#: ../backend.py:71
#, python-format
msgid "%s cannot listen on transcoding port %d."
msgstr "%s nie może nasłuchiwać na porcie transkodowania %d."

#. XML context: item attribute 'description'
#: ../setup.xml:61
msgid "AAC audio bitrate in kbit/s for the Dreamsource encoder. The generic port-8001 pipeline does not expose an audio-bitrate control and therefore keeps the hardware encoder's AAC bitrate."
msgstr "Przepływność dźwięku AAC w kbit/s dla enkodera Dreamsource. Standardowy potok portu 8001 nie udostępnia ustawienia przepływności dźwięku i dlatego zachowuje przepływność AAC enkodera sprzętowego."

#: ../plugin.py:39 ../plugin.py:115
msgid "Advanced"
msgstr "Zaawansowane"

#. XML context: item attribute 'description'
#: ../setup.xml:36
msgid "Allow encoder 0 to choose bitrate or frame-rate behaviour automatically. This option is shown only when the driver exports an automode node."
msgstr "Zezwól enkoderowi 0 na automatyczny wybór przepływności lub liczby klatek na sekundę. Ta opcja jest wyświetlana tylko wtedy, gdy sterownik udostępnia tryb automatyczny."

#. XML context: item attribute 'description'
#: ../setup.xml:51
msgid "Allow encoder 1 to choose automatic bitrate or frame-rate behaviour."
msgstr "Zezwól enkoderowi 1 na automatyczny wybór przepływności lub liczby klatek na sekundę."

#. XML context: item attribute 'description'
#: ../setup.xml:81
msgid "Allow frames to reference pictures from the previous GOP. This can improve compression but may reduce seeking and HLS segment independence."
msgstr "Zezwól klatkom na odwoływanie się do obrazów z poprzedniej grupy GOP. Może to poprawić kompresję, ale może ograniczyć przewijanie i niezależność segmentów HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:49
msgid "Aspect-ratio signalling for encoder 1."
msgstr "Sygnalizacja proporcji obrazu dla enkodera 1."

#. XML context: item attribute 'description'
#: ../setup.xml:34
msgid "Aspect-ratio signalling passed to the encoder. Use the driver default when forced 4:3 or 16:9 signalling produces a distorted picture."
msgstr "Sygnalizacja proporcji obrazu przekazywana do enkodera. Użyj wartości domyślnej sterownika, jeśli wymuszenie 4:3 lub 16:9 powoduje zniekształcenie obrazu."

#. XML context: item attribute 'description'
#: ../setup.xml:48
msgid "Audio codec used by encoder 1 when supported by its driver."
msgstr "Kodek dźwięku używany przez enkoder 1, jeśli jest obsługiwany przez jego sterownik."

#. XML context: item attribute 'description'
#: ../setup.xml:33
msgid "Audio codec used by the hardware encoder when the driver exposes this control. HLS/RTSP always uses AAC because enigma2-live555 currently supports AAC audio only."
msgstr "Kodek dźwięku używany przez enkoder sprzętowy, gdy sterownik udostępnia to ustawienie. HLS/RTSP zawsze używa AAC, ponieważ enigma2-live555 obecnie obsługuje tylko dźwięk AAC."

#: ../configuration.py:173
msgid "Auto (first free)"
msgstr "Auto (pierwszy wolny)"

#. XML context: item attribute 'description'
#: ../setup.xml:8
msgid "Auto is the default and lets every port-8001 request use the first free hardware encoder. Parallel streams can therefore use encoder 0 and encoder 1. Select a fixed encoder only for testing or when a client must always use one physical encoder."
msgstr "Automatycznie jest ustawieniem domyślnym i pozwala każdemu żądaniu na porcie 8001 używać pierwszego wolnego enkodera sprzętowego. Dzięki temu równoległe strumienie mogą korzystać z enkodera 0 i enkodera 1. Wybierz stały enkoder tylko do testów lub gdy klient musi zawsze korzystać z konkretnego enkodera sprzętowego."

#: ../configuration.py:247 ../configuration.py:257 ../configuration.py:385
msgid "Automatic"
msgstr "Automatycznie"

#: ../configuration.py:450
msgid "Baseline"
msgstr "Baseline"

#: ../plugin.py:115
msgid "Basic"
msgstr "Podstawowe"

#: ../configuration.py:106
msgid "Best"
msgstr "Najlepsza"

#. XML context: item attribute 'description'
#: ../setup.xml:8
msgid "Choose a ready-to-use quality profile. Values are adapted to the choices exported by encoder 0. Select Custom to edit the individual settings in Advanced view."
msgstr "Wybierz gotowy profil jakości. Wartości są dostosowane do ustawień udostępnianych przez enkoder 0. Wybierz Niestandardowe, aby edytować poszczególne ustawienia w widoku Zaawansowane."

#. XML context: item attribute 'description'
#: ../setup.xml:11
msgid "Choose an independent quality profile for encoder 1. This does not copy settings from encoder 0."
msgstr "Wybierz niezależny profil jakości dla enkodera 1. Ustawienia z enkodera 0 nie zostaną skopiowane."

#. XML context: item attribute 'description'
#: ../setup.xml:55
msgid "Codec level for encoder 1."
msgstr "Poziom kodeka dla enkodera 1."

#. XML context: item attribute 'description'
#: ../setup.xml:40
msgid "Codec level limits resolution, frame rate and bitrate. A level that is too low for the selected values can prevent the stream from starting."
msgstr "Poziom kodeka określa ograniczenia rozdzielczości, liczby klatek na sekundę i przepływności. Zbyt niski poziom dla wybranych wartości może uniemożliwić uruchomienie strumienia."

#. XML context: item attribute 'description'
#: ../setup.xml:39
msgid "Codec profile exported by the driver. Invalid profile, codec and level combinations can produce a black screen; keep the default when unsure."
msgstr "Profil kodeka udostępniany przez sterownik. Nieprawidłowe połączenie profilu, kodeka i poziomu może powodować czarny ekran. W razie wątpliwości pozostaw wartość domyślną."

#. XML context: item attribute 'description'
#: ../setup.xml:54
msgid "Codec profile for encoder 1. Keep the default when the supported combinations are unknown."
msgstr "Profil kodeka dla enkodera 1. Jeśli obsługiwane kombinacje są nieznane, pozostaw wartość domyślną."

#. XML context: item attribute 'description'
#: ../setup.xml:60
msgid "Codec used by HLS and RTSP. Only H.264 and H.265 are accepted by the current live server; Dreamsource devices are limited to H.264."
msgstr "Kodek używany przez HLS i RTSP. Obecny serwer transmisji obsługuje tylko H.264 i H.265; urządzenia Dreamsource są ograniczone do H.264."

#: ../plugin.py:26
msgid "Configure hardware transcoding, HLS and RTSP"
msgstr "Skonfiguruj transkodowanie sprzętowe, HLS i RTSP"

#: ../configuration.py:108
msgid "Custom"
msgstr "Niestandardowe"

#. XML context: item attribute 'description'
#: ../setup.xml:3
msgid "Enable the receiver's hardware encoder and allow OpenWebif to create reduced-bandwidth streams. Disable this option when the encoder must not be used."
msgstr "Włącz sprzętowy enkoder odbiornika i zezwól OpenWebif na tworzenie strumieni o zmniejszonej przepływności. Wyłącz tę opcję, jeśli enkoder nie ma być używany."

#. XML context: item attribute 'text'
#: ../setup.xml:3
msgid "Enable transcoding"
msgstr "Włącz transkodowanie"

