msgid "High"
msgstr "High"

#: ../configuration.py:105
msgid "Higher"
msgstr "Wyższa"

#: ../configuration.py:393
msgid "Interlaced"
msgstr "Z przeplotem"

#. XML context: item attribute 'text'
#: ../setup.xml:80
msgid "Live B-frames"
msgstr "Klatki B transmisji na żywo"

#. XML context: item attribute 'text'
#: ../setup.xml:78
msgid "Live GOP length"
msgstr "Długość GOP transmisji na żywo"

#. XML context: item attribute 'text'
#: ../setup.xml:79
msgid "Live P-frames"
