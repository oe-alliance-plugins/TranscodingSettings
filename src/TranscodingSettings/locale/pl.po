#: ../plugin.py:98
#, python-format
msgid "Select a preset for Encoder %d. The values are adapted to this device."
msgstr "Wybierz ustawienie dla enkodera %d. Wartości są dostosowane do tego urządzenia."

#: ../plugin.py:41
msgid "Select a ready-to-use preset for the highlighted encoder"
msgstr "Wybierz gotowe ustawienie dla zaznaczonego enkodera"

#: ../plugin.py:42
msgid "Show or hide advanced transcoding settings"
msgstr "Pokaż lub ukryj zaawansowane ustawienia transkodowania"

#. XML context: item attribute 'description'
#: ../setup.xml:82
msgid "Start a new GOP on large scene changes. This may improve quality but produces less predictable segment boundaries."
msgstr "Rozpocznij nowy GOP przy dużych zmianach sceny. Może to poprawić jakość, ale powoduje mniej przewidywalne granice segmentów."

#. XML context: item attribute 'description'
#: ../setup.xml:64
msgid "TCP port used by the HLS HTTP server. It must differ from ports 8001, 8002 and the RTSP port."
msgstr "Port TCP używany przez serwer HTTP HLS. Musi różnić się od portów 8001, 8002 oraz portu RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:70
msgid "TCP/UDP port used by the RTSP server. It must differ from ports 8001, 8002 and the HLS port."
msgstr "Port TCP/UDP używany przez serwer RTSP. Musi różnić się od portów 8001, 8002 oraz portu HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:44
msgid "Target video bitrate for encoder 1."
msgstr "Docelowa przepływność obrazu dla enkodera 1."

#. XML context: item attribute 'description'
#: ../setup.xml:29
msgid "Target video bitrate. A lower value reduces network traffic but also reduces picture quality. Very low bitrates may cause block artifacts or encoder failure at high resolutions."
msgstr "Docelowa przepływność obrazu. Niższa wartość zmniejsza ruch w sieci, ale również obniża jakość obrazu. Bardzo niskie przepływności mogą powodować artefakty blokowe lub błędy enkodera przy wysokich rozdzielczościach."

#. XML context: item attribute 'description'
#: ../setup.xml:20
msgid "The basic port-8001 transcoding stream remains usable. Install the enigma2-live555 binary and an Enigma2 build with the eStreamServer interface to enable HLS and RTSP."
msgstr "Podstawowy strumień transkodowania na porcie 8001 pozostaje dostępny. Zainstaluj plik binarny enigma2-live555 oraz wersję Enigma2 z interfejsem eStreamServer, aby włączyć HLS i RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:28
msgid "The following values configure encoder 0. Unsupported proc controls are not written, but the common values are also used to construct port-8001 streaming requests."
msgstr "Poniższe wartości konfigurują enkoder 0. Nieobsługiwane ustawienia proc nie są zapisywane, ale wspólne wartości są również używane do tworzenia żądań strumieniowania na porcie 8001."

#. XML context: item attribute 'text'
#: ../setup.xml:87
msgid "The generic port-8001 pipeline does not provide separate GOP, profile, level or audio-bitrate controls"
msgstr "Standardowy potok portu 8001 nie udostępnia oddzielnych ustawień GOP, profilu, poziomu ani przepływności dźwięku"

#: ../backend.py:78
msgid "The selected codec is not supported by every encoder that Auto may allocate for HLS/RTSP."
msgstr "Wybrany kodek nie jest obsługiwany przez każdy enkoder, który tryb Automatyczny może przydzielić do HLS/RTSP."

#: ../backend.py:80
msgid "The selected encoder does not support this codec for HLS/RTSP."
msgstr "Wybrany enkoder nie obsługuje tego kodeka dla HLS/RTSP."

#: ../backend.py:49
msgid "The selected transcoding port is not available on this receiver."
msgstr "Wybrany port transkodowania nie jest dostępny na tym odbiorniku."

#. XML context: item attribute 'description'
#: ../setup.xml:59
msgid "These settings control enigma2-live555 only. They do not change the codec choices available to a normal port-8001 or port-8002 client."
msgstr "Te ustawienia sterują wyłącznie enigma2-live555. Nie zmieniają wyboru kodeków dostępnych dla standardowego klienta portu 8001 lub 8002."

