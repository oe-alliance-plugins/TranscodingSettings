#. XML context: item attribute 'text'
#: ../setup.xml:83
msgid "Live encoder slices"
msgstr "Segmenty enkodera transmisji na żywo"

#: ../configuration.py:102
msgid "Low"
msgstr "Niska"

#: ../configuration.py:137 ../configuration.py:147 ../configuration.py:450
msgid "Main"
msgstr "Main"

#: ../configuration.py:107
msgid "Maximum"
msgstr "Maksymalna"

#: ../configuration.py:103
msgid "Medium"
msgstr "Średnia"

#. XML context: item attribute 'text'
#: ../setup.xml:82
msgid "New GOP on scene change"
msgstr "Nowy GOP przy zmianie sceny"

#. XML context: item attribute 'description'
#: ../setup.xml:52
msgid "Number of B-frames in encoder 1's GOP."
msgstr "Liczba klatek B w GOP enkodera 1."

#. XML context: item attribute 'description'
#: ../setup.xml:37
msgid "Number of B-frames in the encoder GOP. B-frames can improve compression but increase latency and are not supported by every profile."
msgstr "Liczba klatek B w GOP enkodera. Klatki B mogą poprawić kompresję, ale zwiększają opóźnienie i nie są obsługiwane przez każdy profil."

#. XML context: item attribute 'description'
#: ../setup.xml:80
msgid "Number of B-frames used by the Dreamsource encoder pipeline. B-frames can increase latency and require a compatible profile."
msgstr "Liczba klatek B używanych przez potok enkodera Dreamsource. Klatki B mogą zwiększyć opóźnienie i wymagają zgodnego profilu."

#. XML context: item attribute 'description'
#: ../setup.xml:83
msgid "Number of H.264 slices. Multiple slices may improve error resilience but add overhead and are not useful for most home networks."
msgstr "Liczba segmentów H.264. Wiele segmentów może poprawić odporność na błędy, ale zwiększa narzut i nie jest przydatne w większości sieci domowych."

#. XML context: item attribute 'description'
#: ../setup.xml:53
msgid "Number of P-frames in encoder 1's GOP."
msgstr "Liczba klatek P w GOP enkodera 1."

#. XML context: item attribute 'description'
#: ../setup.xml:38
msgid "Number of P-frames in the encoder GOP. Larger values improve compression but make recovery after packet loss slower."
msgstr "Liczba klatek P w GOP enkodera. Większe wartości poprawiają kompresję, ale spowalniają odzyskiwanie po utracie pakietów."

#. XML context: item attribute 'description'
#: ../setup.xml:79
msgid "Number of P-frames used when GOP length is automatic. Larger values improve compression but increase recovery latency."
msgstr "Liczba klatek P używanych, gdy długość GOP jest ustawiana automatycznie. Większe wartości poprawiają kompresję, ale zwiększają opóźnienie odzyskiwania."

#: ../configuration.py:461
msgid "Off"
msgstr "Wyłączone"

#: ../configuration.py:461
msgid "On"
msgstr "Włączone"

#. XML context: item attribute 'text'
#: ../setup.xml:81
msgid "Open GOP"
msgstr "Otwarty GOP"

#. XML context: item attribute 'description'
#: ../setup.xml:66
msgid "Optional HTTP user name. Leave empty to disable HLS authentication."
msgstr "Opcjonalna nazwa użytkownika HTTP. Pozostaw puste, aby wyłączyć uwierzytelnianie HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:72
msgid "Optional RTSP user name. Leave empty to disable RTSP authentication."
msgstr "Opcjonalna nazwa użytkownika RTSP. Pozostaw puste, aby wyłączyć uwierzytelnianie RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:45
msgid "Output dimensions for encoder 1."
msgstr "Wymiary wyjściowe dla enkodera 1."

#. XML context: item attribute 'description'
#: ../setup.xml:30
msgid "Output dimensions. High resolutions need a sufficiently high bitrate and may not be accepted with every codec or frame rate."
msgstr "Wymiary wyjściowe. Wysokie rozdzielczości wymagają odpowiednio wysokiej przepływności i mogą nie być obsługiwane z każdym kodekiem lub przy każdej liczbie klatek."

#. XML context: item attribute 'description'
#: ../setup.xml:46
msgid "Output frame rate for encoder 1."
msgstr "Wyjściowa liczba klatek dla enkodera 1."

#. XML context: item attribute 'description'
#: ../setup.xml:31
msgid "Output frame rate. Do not combine a high frame rate, high resolution and low bitrate unless the encoder is known to support it."
msgstr "Wyjściowa liczba klatek. Nie łącz wysokiej liczby klatek, wysokiej rozdzielczości i niskiej przepływności, chyba że wiadomo, że enkoder to obsługuje."

#. XML context: item attribute 'description'
#: ../setup.xml:67
msgid "Password used with the HLS user name."
msgstr "Hasło używane wraz z nazwą użytkownika HLS."

#. XML context: item attribute 'description'
#: ../setup.xml:73
msgid "Password used with the RTSP user name."
msgstr "Hasło używane wraz z nazwą użytkownika RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:65
msgid "Playlist path without leading or trailing slash. For example, path 'stream' creates /stream.m3u8."
msgstr "Ścieżka playlisty bez początkowego ani końcowego ukośnika. Na przykład ścieżka „stream” tworzy /stream.m3u8."

#. XML context: item attribute 'description'
#: ../setup.xml:5
msgid "Port 8001 uses the Enigma2 stream server and supports the optional HLS and RTSP service. Port 8002 uses the BCM transcoding proxy and never provides HLS or RTSP."
msgstr "Port 8001 korzysta z serwera strumieniowego Enigma2 i obsługuje opcjonalne usługi HLS i RTSP. Port 8002 korzysta z serwera proxy transkodowania BCM i nigdy nie udostępnia HLS ani RTSP."

#. XML context: item attribute 'description'
#: ../setup.xml:24
msgid "Port 8002 is retained for BCM receivers and the classic transcoding proxy. Select port 8001 to use HLS or RTSP."
msgstr "Port 8002 jest zachowany dla odbiorników BCM i klasycznego serwera proxy transkodowania. Wybierz port 8001, aby używać HLS lub RTSP."

#: ../plugin.py:38
msgid "Presets"
msgstr "Ustawienia"

#: ../configuration.py:393
msgid "Progressive"
msgstr "Progresywny"

#. XML context: item attribute 'description'
#: ../setup.xml:50
msgid "Progressive or interlaced output for encoder 1."
msgstr "Wyjście progresywne lub z przeplotem dla enkodera 1."

#. XML context: item attribute 'description'
#: ../setup.xml:35
msgid "Progressive output is normally appropriate for HLS/RTSP. Interlaced output can be incompatible with some clients and encoder combinations."
msgstr "Wyjście progresywne jest zazwyczaj odpowiednie dla HLS/RTSP. Wyjście z przeplotem może być niezgodne z niektórymi klientami i kombinacjami enkodera."

#. XML context: item attribute 'description'
#: ../setup.xml:17
msgid "Publish the selected transcoded service as an HLS playlist. Saving this option starts enigma2-live555 on demand. The daemon stops again when both HLS and RTSP are disabled, transcoding is disabled, or port 8002 is selected. HLS uses H.264 or H.265 video with AAC audio."
msgstr "Udostępniaj wybraną transkodowaną usługę jako playlistę HLS. Zapisanie tej opcji uruchamia na żądanie enigma2-live555. Daemon zostaje zatrzymany, gdy HLS i RTSP są wyłączone, transkodowanie jest wyłączone lub wybrano port 8002. HLS używa obrazu H.264 lub H.265 z dźwiękiem AAC."

#. XML context: item attribute 'description'
#: ../setup.xml:18
msgid "Publish the selected transcoded service through RTSP. Saving this option starts enigma2-live555 on demand. The daemon stops again when both HLS and RTSP are disabled, transcoding is disabled, or port 8002 is selected. TCP transport is normally more reliable than UDP on wireless networks."
msgstr "Udostępniaj wybraną transkodowaną usługę przez RTSP. Zapisanie tej opcji uruchamia na żądanie enigma2-live555. Daemon zostaje zatrzymany, gdy HLS i RTSP są wyłączone, transkodowanie jest wyłączone lub wybrano port 8002. Transport TCP jest zazwyczaj bardziej niezawodny niż UDP w sieciach bezprzewodowych."

